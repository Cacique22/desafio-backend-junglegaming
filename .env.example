# ==============================================================================
# JUNGLE GAMING - CONFIGURAÇÕES DE AMBIENTE LOCAL (.env.example)
# ==============================================================================

# Servidor HTTP
PORT=8080

# PostgreSQL 16
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=wager_db
DB_SSLMODE=disable

# Keycloak OIDC / JWT
KEYCLOAK_ISSUER=http://localhost:8085/realms/jungle
JWT_SECRET=super-secret-development-key-32bytes!!
ALLOW_DEV_TOKENS=true

# AWS SQS FIFO / LocalStack
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_COMMAND_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_OUTBOX_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
